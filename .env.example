GEMINI_API_KEY=
PORT=3000
NODE_ENV=development
DISCOVERY_DEMO_MODE=false
AGENTLESS_SECRET_KEY=
DISCOVERY_APPROVED_CIDRS=
# Local SNMP printer collector. Set SNMPWALK_PATH if the executable is not in
# ../SnmpWalk/snmpwalk.exe. Keep any non-public community or SNMPv3 secrets in
# your local .env only; do not commit them.
SNMPWALK_PATH=
SNMP_VERSION=1
SNMP_COMMUNITY=public
SNMP_TIMEOUT_SECONDS=15
VITE_ITAM_SERVER_URL=https://your-itam-server.example.com
# Public URL used by downloadable endpoint agents. Set this when the server
# is behind a reverse proxy, VPN, or a non-default LAN address.
PUBLIC_SERVER_URL=http://192.168.1.24:3000
