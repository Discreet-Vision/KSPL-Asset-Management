# Production Dockerfile for ITAM Normalization Engine Service
FROM python:3.11-slim

WORKDIR /app
COPY normalization_service/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY normalization_service/ ./normalization_service/

USER 10001
EXPOSE 8082

CMD ["uvicorn", "normalization_service.api.server:app", "--host", "0.0.0.0", "--port", "8082"]
