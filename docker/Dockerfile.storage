# Production Dockerfile for ITAM S3-Compatible Object Storage Service
FROM python:3.11-slim

WORKDIR /app
COPY object_storage_service/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY object_storage_service/ ./object_storage_service/

USER 10001
EXPOSE 8084

CMD ["uvicorn", "object_storage_service.api.server:app", "--host", "0.0.0.0", "--port", "8084"]
